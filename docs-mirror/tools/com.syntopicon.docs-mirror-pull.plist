<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- docs-mirror 주간 pull (PLAN §3 — launchd, cron 불채택: 슬립 유실·조용한 실패).
     설치 1회: launchctl bootstrap gui/$(id -u) tools/com.syntopicon.docs-mirror-pull.plist
     해제:     launchctl bootout   gui/$(id -u)/com.syntopicon.docs-mirror-pull -->
<dict>
  <key>Label</key>
  <string>com.syntopicon.docs-mirror-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/angyojun/workspace/syntopicon/docs-mirror/tools/mirror</string>
    <string>pull</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
