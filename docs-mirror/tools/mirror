#!/usr/bin/env python3
"""docs-mirror 단일 CLI (PLAN §2·§3). 결정적·LLM 무관.

하위명령: validate | add <tech> [repo] | pull | status | remove <tech> | reset <tech>

동시성 모델 (PLAN §3): 단일 writer 전제. repo 내 잠금은 git에 위임,
pull은 flock 단일 인스턴스 가드, 크로스 소스 원자성은 비보장(실패 = 낡은 캐시, fail-loud).
YAML 읽기/쓰기는 yq(v4) 경유 — 주석 보존.
"""
import fcntl
import fnmatch
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCES = ROOT / "sources.yaml"
MIRRORS = ROOT / "mirrors"
LOGS = ROOT / "logs"
STATE = LOGS / "state.json"
CACHEDIR_SIG = "Signature: 8a477f597d28d172789f06886806bc55\n"
SWH_API = "https://archive.softwareheritage.org/api/1/origin/save/git/url/"
ASF_RELEASES = "https://projects.apache.org/json/foundation/releases.json"


class MirrorError(Exception):
    """소스 하나의 실패. 호출자가 모아서 fail-loud 하도록 die 대신 던진다."""


def run(cmd, check=True, capture=True, cwd=None):
    return subprocess.run(cmd, check=check, cwd=cwd,
                          capture_output=capture, text=True)


def die(msg, code=1):
    print(f"[mirror] 오류: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _reject_dup_keys(pairs):
    """중복 키는 조용한 유실이므로 실패시킨다 (PLAN §3 규율).

    yq는 중복 매핑 키를 거부하지 않고 JSON에 그대로 두 번 내보내며,
    json.loads의 기본 동작은 뒤엣것만 남기고 앞엣것을 말없이 버린다 —
    소스 하나가 경고 없이 사라지는 경로라 파싱 시점에 막는다.
    """
    obj = {}
    for k, v in pairs:
        if k in obj:
            die(f"sources.yaml: 키 중복 '{k}' — 한쪽이 조용히 유실된다")
        obj[k] = v
    return obj


def load_registry():
    if not SOURCES.exists():
        die(f"{SOURCES} 없음")
    out = run(["yq", "-o=json", ".", str(SOURCES)]).stdout
    reg = json.loads(out, object_pairs_hook=_reject_dup_keys)
    if not isinstance(reg.get("sources"), dict) or not isinstance(reg.get("config"), dict):
        die("sources.yaml 최상위에 config·sources 필요")
    return reg


def write_source(tech, entry):
    env = dict(os.environ, TECH=tech, ENTRY=json.dumps(entry, ensure_ascii=False))
    subprocess.run(
        ["yq", "-i", '.sources[strenv(TECH)] = (strenv(ENTRY) | fromjson)', str(SOURCES)],
        check=True, env=env)
    subprocess.run(["yq", "-i", "-P", ".", str(SOURCES)], check=True)  # block 스타일 유지


def ensure_cachedir_tag():
    MIRRORS.mkdir(exist_ok=True)
    tag = MIRRORS / "CACHEDIR.TAG"
    if not tag.exists():
        tag.write_text(CACHEDIR_SIG + "# docs-mirror 캐시 — 백업 도구 제외 표식 (PLAN §3)\n")


def repo_slug(url):
    parts = url.rstrip("/").removesuffix(".git").split("/")
    return parts[-2], parts[-1]  # (owner, name)


def current_dir(tech):
    return MIRRORS / tech / "current"


# ------------------------------------------------- 릴리스 해석 (PLAN §2·§3)
# current/ = 최신 릴리스 태그. 기본 브랜치는 미출시 개발본이라 그대로 두면
# 캐시가 "존재하지 않는 버전의 문서"를 현행인 양 답하게 된다(실측: spark
# 5.0.0-SNAPSHOT, kafka 4.4.0-SNAPSHOT 등 8건 중 6건).
#
# 릴리스 판정은 벤더가 이미 구조화해 둔 데이터만 쓴다 — 버전 문자열의
# 프리릴리스 접미사를 알아맞히지 않는다(-rc6·rc2·b1·a1·.dev로 제각각이라
# 패턴이 무한증식하는 greedy 경로다):
#   github — Releases API의 prerelease·draft 불리언이 벤더 자신의 판정이고
#            tag_name을 그대로 준다. 파싱 0.
#   asf    — GitHub Releases를 쓰지 않는 ASF 프로젝트(spark·kafka)용.
#            공식 릴리스 목록에는 RC가 애초에 실리지 않는다.
# 버전 대소 비교도 자체 파서를 쓰지 않고 git(--sort=v:refname)에 위임한다.

def _github_release_tags(owner, name, glob):
    tags = []
    for page in (1, 2, 3):
        r = run(["gh", "api", f"repos/{owner}/{name}/releases?per_page=100&page={page}",
                 "--jq", "map(select(.prerelease==false and .draft==false)) | .[].tag_name"],
                check=False)
        if r.returncode != 0:
            raise MirrorError(f"GitHub Releases 조회 실패 — {r.stderr.strip()}")
        page_tags = r.stdout.split()
        if not page_tags:
            break
        tags += page_tags
    return [t for t in tags if not glob or fnmatch.fnmatch(t, glob)]


def _asf_release_tags(project, glob):
    r = run(["curl", "-sf", "--max-time", "30", ASF_RELEASES], check=False)
    if r.returncode != 0:
        raise MirrorError(f"ASF 릴리스 메타데이터 조회 실패 — {ASF_RELEASES}")
    data = json.loads(r.stdout).get(project)
    if not data:
        raise MirrorError(f"ASF 릴리스 메타데이터에 프로젝트 '{project}' 없음")
    cands = []
    for artifact in data:
        if glob and not fnmatch.fnmatch(artifact, glob):
            continue
        ver = artifact.rsplit("-", 1)[-1]  # ASF 표기 = <아티팩트>-<버전>
        cands += [ver, "v" + ver]  # 태그 표기 두 형태만. 그 밖은 실패시킨다
    return cands


def _tag_is_version(tag, version):
    """태그가 그 버전의 태그인가 — 접두는 벤더 자유(v3.5.9·apache-iceberg-1.11.0·4.3.1).

    단순 endswith는 v13.5.9를 3.5.9로 통과시킨다. 접두가 버전의 일부가 아니려면
    잘라낸 나머지의 끝이 숫자도 점도 아니어야 한다.
    """
    if not tag.endswith(version):
        return False
    rest = tag[:-len(version)]
    return rest == "" or (not rest[-1].isdigit() and rest[-1] != ".")


def resolve_release_tag(tech, entry, cur):
    """최신 릴리스 태그. release_from이 none이면 None (기본 브랜치 추종)."""
    src = entry.get("release_from") or "none"
    if src == "none":
        return None
    glob = entry.get("release_glob")
    owner, name = repo_slug(entry["repo"])
    if src == "github":
        cands = _github_release_tags(owner, name, glob)
    elif src == "asf":
        cands = _asf_release_tags(name, glob)
    else:
        raise MirrorError(f"release_from 값 불량: {src}")
    if not cands:
        raise MirrorError(f"릴리스 후보 0건 (release_glob={glob}) — 판정 불가")
    r = run(["git", "-C", str(cur), "tag", "--list", *cands, "--sort=-v:refname"],
            check=False)
    tags = r.stdout.split()
    if not tags:
        raise MirrorError(f"릴리스 {len(cands)}건 중 클론에 존재하는 태그 0건 — 판정 불가")
    return tags[0]


def checkout_release(tech, entry, cur):
    """릴리스 핀 소스를 최신 릴리스로 이동. 반환 = (태그, 이동했는가)."""
    tag = resolve_release_tag(tech, entry, cur)
    if tag is None:
        return None, False
    head = run(["git", "-C", str(cur), "rev-parse", "HEAD"], check=False).stdout.strip()
    want = run(["git", "-C", str(cur), "rev-parse", f"{tag}^{{commit}}"],
               check=False).stdout.strip()
    if head and head == want and entry.get("pinned") == tag:
        return tag, False
    r = run(["git", "-C", str(cur), "checkout", "--detach", tag], check=False)
    if r.returncode != 0:
        raise MirrorError(f"{tag} 체크아웃 실패 — {r.stderr.strip()}")
    return tag, True


def notify(text):
    try:
        run(["osascript", "-e",
             f'display notification "{text}" with title "docs-mirror"'], check=False)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------- validate
def cmd_validate(_args):
    reg = load_registry()
    problems, warnings = [], []
    if not reg["config"].get("fork_org"):
        problems.append("config.fork_org 없음")
    for tech, e in reg["sources"].items():
        if not e.get("repo") and not e.get("crawl"):
            problems.append(f"{tech}: repo·crawl 둘 다 없음")
        if e.get("repo") and e.get("crawl"):
            problems.append(f"{tech}: repo와 crawl은 택일 (git 미러 우선, 원칙 3)")
        if e.get("format") not in ("md", "mdx", "rst", "docbook", "html"):
            problems.append(f"{tech}: format 값 불량: {e.get('format')}")
        if not e.get("license"):
            problems.append(f"{tech}: license 미기록 (필수)")
        if e.get("repo") and not e.get("fork"):
            warnings.append(f"{tech}: fork 미가동 — §3.5 0겹 부재. `mirror add {tech}` 재실행으로 보수")
        if e.get("release_from") not in ("github", "asf", "none"):
            problems.append(f"{tech}: release_from 값 불량: {e.get('release_from')} "
                            f"(github|asf|none — PLAN §2)")
        if (e.get("release_from") or "none") == "none" and e.get("pinned"):
            problems.append(f"{tech}: release_from=none인데 pinned 기록됨 ({e['pinned']})")
        if e.get("release_from") in ("github", "asf") and not e.get("pinned"):
            warnings.append(f"{tech}: 릴리스 미핀 — `mirror pull`로 최신 릴리스에 고정")
        if e.get("fork") and e["fork"].rstrip("/").rsplit("/", 1)[-1] != tech:
            problems.append(
                f"{tech}: fork 이름이 레지스트리 키와 불일치 ({e['fork']}) — "
                f"§3.5 규약은 fork 이름 = tech 키. "
                f"`gh repo rename {tech} --repo <org>/<현재이름>` 후 fork URL 갱신")
        if e.get("repo") and not e.get("swh_registered"):
            warnings.append(f"{tech}: SWH 미등록 — `mirror add {tech}` 재실행으로 보수")
        cur = current_dir(tech)
        if e.get("repo") and not cur.is_dir():
            warnings.append(f"{tech}: mirrors/{tech}/current 미클론 — `mirror add {tech}` 재실행")
        for v in e.get("versions") or []:
            vdir = MIRRORS / tech / v
            if not vdir.is_dir():
                problems.append(f"{tech}: 등록 버전 {v}의 워크트리 없음")
                continue
            # 고정 워크트리는 이름이 곧 정체여야 한다 — 디렉토리명은 패치까지의
            # 완전한 버전이고, 그 버전의 태그에 실제로 고정돼 있어야 한다.
            tags = run(["git", "-C", str(vdir), "tag", "--points-at", "HEAD"],
                       check=False).stdout.split()
            if not tags:
                problems.append(f"{tech}: 버전 워크트리 {v}가 태그에 고정되지 않음 "
                                f"(고정 워크트리는 불변이어야 한다 — PLAN §2)")
            elif not any(_tag_is_version(t, v) for t in tags):
                problems.append(f"{tech}: 버전 워크트리 {v}의 실제 태그가 "
                                f"{', '.join(tags)} — 디렉토리명과 불일치")
    # 미등록 잔류물 검출 (삭제 게이트 ⑴과 동형)
    if MIRRORS.is_dir():
        known = set(reg["sources"]) | {"CACHEDIR.TAG", "_converted"}
        for p in MIRRORS.iterdir():
            if p.name not in known:
                problems.append(f"mirrors/{p.name}: 레지스트리 미등록 잔류물 — 계약 밖 물건")
    for w in warnings:
        print(f"[mirror] 경고: {w}")
    if problems:
        for p in problems:
            print(f"[mirror] 위반: {p}", file=sys.stderr)
        sys.exit(1)
    print(f"[mirror] validate OK — 소스 {len(reg['sources'])}건, 경고 {len(warnings)}건")


# ---------------------------------------------------------------- add
def cmd_add(args):
    if not args:
        die("사용법: mirror add <tech> [repo-url] [--subdir D] [--format F] "
            "[--release-from github|asf|none] [--release-glob G] [--fallback URL ...]")
    tech, rest = args[0], args[1:]
    reg = load_registry()
    entry = reg["sources"].get(tech) or {
        "repo": None, "subdir": None, "format": "md", "license": None,
        "release_from": None, "release_glob": None, "pinned": None,
        "versions": [], "fork": None, "swh_registered": None,
        "fallback": [], "added": now(),
    }
    it = iter(rest)
    for a in it:
        if a == "--subdir":
            entry["subdir"] = next(it)
        elif a == "--format":
            entry["format"] = next(it)
        elif a == "--release-from":
            entry["release_from"] = next(it)
        elif a == "--release-glob":
            entry["release_glob"] = next(it)
        elif a == "--fallback":
            entry.setdefault("fallback", []).append(next(it))
        elif a.startswith("http"):
            entry["repo"] = a.removesuffix(".git")
        else:
            die(f"알 수 없는 인자: {a}")
    if not entry["repo"]:
        die(f"{tech}: repo URL 필요 (기존 항목도 없음)")
    owner, name = repo_slug(entry["repo"])

    # ① license (미기록 시 gh api로)
    if not entry["license"]:
        r = run(["gh", "api", f"repos/{owner}/{name}", "--jq",
                 '.license.spdx_id // "NOASSERTION"'], check=False)
        entry["license"] = r.stdout.strip() if r.returncode == 0 else None
        print(f"[mirror] {tech}: license = {entry['license']}")

    # ② clone (blobless + sparse, gc.auto=0 — r9 백업 규율)
    cur = current_dir(tech)
    if not cur.is_dir():
        ensure_cachedir_tag()
        cur.parent.mkdir(parents=True, exist_ok=True)
        cmd = ["git", "clone", "--filter=blob:none", entry["repo"] + ".git", str(cur)]
        if entry["subdir"]:
            cmd.insert(2, "--sparse")
        print(f"[mirror] {tech}: clone 중…")
        run(cmd, capture=False)
        if entry["subdir"]:
            run(["git", "-C", str(cur), "sparse-checkout", "set", entry["subdir"]])
        run(["git", "-C", str(cur), "config", "gc.auto", "0"])
        print(f"[mirror] {tech}: clone 완료 → mirrors/{tech}/current")
    else:
        print(f"[mirror] {tech}: clone 존재 — 건너뜀")

    # ②-b 릴리스 핀 (PLAN §2) — 미지정이면 GitHub Releases 사용 여부로 판정.
    # ASF 프로젝트나 서브프로젝트 혼재 저장소는 --release-from·--release-glob으로 명시.
    if entry.get("release_from") is None:
        has_rel = run(["gh", "api", f"repos/{owner}/{name}/releases/latest"],
                      check=False).returncode == 0
        entry["release_from"] = "github" if has_rel else "none"
        print(f"[mirror] {tech}: release_from = {entry['release_from']} (자동 판정)")
    if entry["release_from"] != "none":
        try:
            tag, moved = checkout_release(tech, entry, cur)
        except MirrorError as exc:
            die(f"{tech}: 릴리스 판정 실패 — {exc}")
        entry["pinned"] = tag
        print(f"[mirror] {tech}: 릴리스 핀 = {tag}" + ("" if moved else " (이미 해당 위치)"))

    # ③ fork (§3.5 0겹) — org 미생성 등 실패는 fail-loud 후 계속
    org = reg["config"]["fork_org"]
    if not entry["fork"]:
        if run(["gh", "api", f"orgs/{org}"], check=False).returncode != 0:
            print(f"[mirror] 경고: org '{org}' 접근 불가 — fork 건너뜀. "
                  f"org 생성 후 `mirror add {tech}` 재실행", file=sys.stderr)
        else:
            # fork 이름 = 레지스트리 키 (§3.5) — upstream 이름을 그대로 쓰면
            # 'docs'처럼 일반적인 이름이 org를 선점해 다음 소스와 충돌한다.
            r = run(["gh", "repo", "fork", f"{owner}/{name}", "--org", org,
                     "--fork-name", tech, "--clone=false"], check=False)
            if r.returncode == 0:
                entry["fork"] = f"https://github.com/{org}/{tech}"
                print(f"[mirror] {tech}: fork = {entry['fork']}")
            else:
                print(f"[mirror] 경고: fork 실패 — {r.stderr.strip()}", file=sys.stderr)

    # ④ SWH save-code-now (§3.5 0겹-보조)
    if not entry["swh_registered"]:
        r = run(["curl", "-sf", "-X", "POST", SWH_API + entry["repo"] + "/"], check=False)
        if r.returncode == 0:
            entry["swh_registered"] = now()
            print(f"[mirror] {tech}: SWH 등록 완료")
        else:
            print(f"[mirror] 경고: SWH 등록 실패 — `mirror add {tech}` 재실행으로 보수",
                  file=sys.stderr)

    # ⑤ 레지스트리 기록
    write_source(tech, entry)
    print(f"[mirror] {tech}: sources.yaml 기록 완료")


# ---------------------------------------------------------------- pull
def cmd_pull(_args):
    LOGS.mkdir(exist_ok=True)
    lock = open(LOGS / "pull.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("[mirror] pull 이미 실행 중 — 무해 종료")
        return
    reg = load_registry()
    ok, fail, moved = [], [], []
    for tech, e in reg["sources"].items():
        if not e.get("repo"):
            continue  # crawl 소스는 pull 대상 아님
        cur = current_dir(tech)
        if not cur.is_dir():
            fail.append((tech, "clone 없음 — `mirror add`로 보수"))
            continue
        if (e.get("release_from") or "none") == "none":
            # 버전 축이 없거나 문서가 버전 조건을 인라인 표기하는 소스 — 브랜치 추종
            r = run(["git", "-C", str(cur), "pull", "--ff-only"], check=False)
            if r.returncode != 0:
                fail.append((tech, r.stderr.strip().splitlines()[-1] if r.stderr else "?"))
                continue
            ok.append(tech)
            continue
        r = run(["git", "-C", str(cur), "fetch", "--tags", "--prune", "origin"], check=False)
        if r.returncode != 0:
            fail.append((tech, r.stderr.strip().splitlines()[-1] if r.stderr else "?"))
            continue
        try:
            tag, did_move = checkout_release(tech, e, cur)
        except MirrorError as exc:
            fail.append((tech, str(exc)))
            continue
        if did_move:
            e["pinned"] = tag
            write_source(tech, e)
            moved.append(f"{tech} {tag}")
        ok.append(tech)
        # 고정 버전 워크트리는 불변이므로 skip (PLAN §3)
    STATE.write_text(json.dumps(
        {"last_run": now(), "ok": ok, "fail": [t for t, _ in fail], "moved": moved},
        ensure_ascii=False, indent=1))
    print(f"[mirror] pull: 성공 {len(ok)}건" + (f" — {', '.join(ok)}" if ok else ""))
    if moved:
        print(f"[mirror] 릴리스 이동 {len(moved)}건 — {', '.join(moved)}")
    if fail:  # fail-loud (PLAN §3): 목록 출력 + macOS 알림 + 비정상 종료
        for tech, msg in fail:
            print(f"[mirror] 실패: {tech} — {msg}", file=sys.stderr)
        notify(f"pull 실패 {len(fail)}건: " + ", ".join(t for t, _ in fail))
        sys.exit(1)


# ---------------------------------------------------------------- status
def cmd_status(_args):
    reg = load_registry()
    if STATE.exists():
        st = json.loads(STATE.read_text())
        line = f"[mirror] 마지막 pull: {st['last_run']} — 성공 {len(st['ok'])}건"
        if st["fail"]:
            line += f", 실패: {', '.join(st['fail'])}"
        print(line)
    else:
        print("[mirror] pull 실행 이력 없음")
    for tech, e in reg["sources"].items():
        cur = current_dir(tech)
        if e.get("repo") and cur.is_dir():
            age = run(["git", "-C", str(cur), "log", "-1", "--format=%cr"],
                      check=False).stdout.strip()
            dirty = run(["git", "-C", str(cur), "status", "--porcelain"],
                        check=False).stdout.strip()
            vers = ", ".join(e.get("versions") or []) or "-"
            pin = e.get("pinned") or ("기본 브랜치" if (e.get("release_from") or "none")
                                      == "none" else "미핀!")
            flags = (" [fork✓]" if e.get("fork") else " [fork✗]") + \
                    (" [SWH✓]" if e.get("swh_registered") else " [SWH✗]") + \
                    (" [DIRTY — 인간 저작물 혼입 의심!]" if dirty else "")
            print(f"  {tech}: {pin} | HEAD {age} | 고정: {vers}{flags}")
        elif e.get("repo"):
            print(f"  {tech}: 미클론 — `mirror add {tech}` 재실행")
        else:
            print(f"  {tech}: crawl 소스 (pull 비대상)")


# ---------------------------------------------------------------- remove / reset
def deletion_gate(tech, reg):
    """삭제 게이트 (PLAN §3) — 파괴 연산 전 3중 검증."""
    if tech not in reg["sources"]:
        die(f"{tech}: 레지스트리 미등록 — 계약 밖 물건. mirrors/ 내용:\n  " +
            "\n  ".join(p.name for p in MIRRORS.iterdir() if p.is_dir()))
    e = reg["sources"][tech]
    tdir = MIRRORS / tech
    for sub in sorted(p for p in tdir.iterdir() if p.is_dir()) if tdir.is_dir() else []:
        if (sub / ".git").exists():
            dirty = run(["git", "-C", str(sub), "status", "--porcelain"],
                        check=False).stdout.strip()
            if dirty:
                die(f"{tech}/{sub.name}: 워킹트리 더러움 — 인간 저작물 혼입 신호, 중단:\n{dirty}")
    if not e.get("fork") or not e.get("swh_registered"):
        print(f"[mirror] 경고: {tech} 보존 계층 미가동(fork={e.get('fork')}, "
              f"SWH={e.get('swh_registered')}) — 손실 예산이 upstream 소멸분까지 확대된 상태",
              file=sys.stderr)
    ans = input(f"[mirror] {tech} 삭제를 진행하나? [y/N] ").strip().lower()
    if ans != "y":
        die("중단", 0)


def cmd_remove(args):
    if not args:
        die("사용법: mirror remove <tech>")
    tech = args[0]
    reg = load_registry()
    deletion_gate(tech, reg)
    subprocess.run(["rm", "-rf", str(MIRRORS / tech)], check=True)
    env = dict(os.environ, TECH=tech)
    subprocess.run(["yq", "-i", 'del(.sources[strenv(TECH)])', str(SOURCES)],
                   check=True, env=env)
    print(f"[mirror] {tech}: mirrors/ 삭제 + 레지스트리 항목 제거 완료")


def cmd_reset(args):
    if not args:
        die("사용법: mirror reset <tech>")
    tech = args[0]
    reg = load_registry()
    deletion_gate(tech, reg)
    subprocess.run(["rm", "-rf", str(MIRRORS / tech)], check=True)
    print(f"[mirror] {tech}: 삭제 완료 — 재클론 중…")
    cmd_add([tech])


COMMANDS = {"validate": cmd_validate, "add": cmd_add, "pull": cmd_pull,
            "status": cmd_status, "remove": cmd_remove, "reset": cmd_reset}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die("사용법: mirror <validate|add|pull|status|remove|reset> …")
    COMMANDS[sys.argv[1]](sys.argv[2:])
