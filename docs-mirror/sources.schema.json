{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docs-mirror sources registry",
  "description": "미러 대상 레지스트리의 계약 (PLAN §2). 상태=sources.yaml, 연산=tools/mirror.",
  "type": "object",
  "required": ["config", "sources"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["fork_org"],
      "additionalProperties": false,
      "properties": {
        "fork_org": {
          "type": "string",
          "description": "§3.5 0겹 fork 네임스페이스 (GitHub org)"
        }
      }
    },
    "sources": {
      "type": "object",
      "description": "기술명 → 소스 항목",
      "additionalProperties": {
        "type": "object",
        "required": ["mode"],
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "mode": { "const": "ondemand" } }, "required": ["mode"] },
            "then": {
              "required": ["index"],
              "properties": {
                "repo": { "const": null },
                "crawl": { "const": null },
                "versions": { "maxItems": 0 }
              }
            },
            "else": { "required": ["format", "license", "release_from"] }
          }
        ],
        "properties": {
          "mode": {
            "enum": ["mirror", "ondemand"],
            "description": "mirror=로컬 사본을 둔다(pull·fork·SWH 대상). ondemand=사본 없이 조회 경로만 기록한다 — git 공급이 없고 버전 축도 없어 미러가 지는 소스(PLAN 원칙 7)"
          },
          "index": {
            "type": ["string", "null"],
            "description": "ondemand 진입 색인 URL (llms.txt 등). 라우팅의 출발점"
          },
          "page_suffix": {
            "type": ["string", "null"],
            "description": "ondemand 페이지의 기계 판독본 규약 (예: AWS는 문서 URL 뒤 '.md')"
          },
          "search": {
            "type": ["string", "null"],
            "description": "ondemand 전문 검색 엔드포인트. 호출 형태는 스킬이 규정(상태=파일, 절차=스킬)"
          },
          "mcp": {
            "type": ["string", "null"],
            "description": "공식 원격 MCP 엔드포인트 (보완·폴백). 등록은 세션 설정이라 레이어가 강제하지 않는다"
          },
          "repo": {
            "type": ["string", "null"],
            "description": "git 저장소 URL (수집 ①·② 경로). crawl과 택일"
          },
          "crawl": {
            "type": ["string", "null"],
            "description": "크롤 시작 URL (수집 ③ 최후 수단). repo 부재 시만"
          },
          "subdir": {
            "type": ["string", "null"],
            "description": "sparse-checkout 대상 하위 디렉토리"
          },
          "format": {
            "enum": ["md", "mdx", "rst", "docbook", "html"],
            "description": "원문 포맷. rst·docbook은 _converted/ 변환 대상"
          },
          "license": {
            "type": ["string", "null"],
            "description": "SPDX id (필수 기록 — add가 gh api로 채움)"
          },
          "release_from": {
            "enum": ["github", "asf", "none"],
            "description": "current/의 최신 릴리스를 어디서 판정하는가. github=Releases API의 prerelease 플래그, asf=projects.apache.org 공식 릴리스 목록, none=릴리스 축 없음(기본 브랜치 추종)"
          },
          "release_glob": {
            "type": ["string", "null"],
            "description": "릴리스 후보 필터 (github=태그명, asf=아티팩트명). 서브프로젝트 릴리스 배제용 — 버전 접미사 판별용이 아니다"
          },
          "pinned": {
            "type": ["string", "null"],
            "description": "current/가 현재 체크아웃한 릴리스 태그. pull이 기록 — 버전 이동이 git 이력에 남는다. release_from=none이면 null"
          },
          "versions": {
            "type": "array",
            "items": { "type": "string" },
            "description": "고정 워크트리로 펼친 태그 목록 (선제 생성 금지)"
          },
          "fork": {
            "type": ["string", "null"],
            "description": "§3.5 0겹 fork URL. null = 미가동(validate가 경고)"
          },
          "swh_registered": {
            "type": ["string", "null"],
            "description": "Software Heritage save-code-now 등록일 (ISO)"
          },
          "fallback": {
            "type": "array",
            "items": { "type": "string" },
            "description": "온디맨드 폴백 (llms.txt·공식 MCP·이슈 트래커 URL)"
          },
          "added": {
            "type": "string",
            "description": "등록일 (ISO)"
          }
        }
      }
    }
  }
}
